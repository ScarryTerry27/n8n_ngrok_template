        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"is_exam_note_request\", \"follow_up_questions\", \"exam_note\"],\n  \"properties\": {\n    \"is_exam_note_request\": {\n      \"type\": \"boolean\",\n      \"description\": \"True если запрос релевантен оформлению осмотра/истории/выписки/протокола или структурированию клинических данных.\"\n    },\n    \"follow_up_questions\": {\n      \"description\": \"Если нужно уточнение — массив ровно из 3 вопросов. Если уточнение не нужно — null.\",\n      \"oneOf\": [\n        { \"type\": \"null\" },\n        {\n          \"type\": \"array\",\n          \"minItems\": 3,\n          \"maxItems\": 3,\n          \"items\": { \"type\": \"string\" }\n        }\n      ]\n    },\n    \"exam_note\": {\n      \"description\": \"Заполняется только если уточнение не нужно (follow_up_questions=null) и запрос релевантен. Иначе null.\",\n      \"oneOf\": [\n        { \"type\": \"null\" },\n        {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"required\": [\n            \"complaints\",\n            \"anamnesis\",\n            \"objective_status\",\n            \"functional_data\",\n            \"therapy\",\n            \"recommendations\"\n          ],\n          \"properties\": {\n            \"complaints\": { \"type\": \"string\" },\n            \"anamnesis\": { \"type\": \"string\" },\n            \"objective_status\": { \"type\": \"string\" },\n            \"functional_data\": { \"type\": \"string\" },\n            \"therapy\": { \"type\": \"string\" },\n            \"recommendations\": { \"type\": \"string\" }\n          }\n        }\n      ]\n    }\n  }\n}"
